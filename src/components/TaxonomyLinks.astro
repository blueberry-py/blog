---
import { getCollection } from 'astro:content';
import { collectTerms, termSlug } from '../lib/taxonomy.ts';
import { withBase } from '../lib/site.ts';

interface Props {
  tags?: string[];
  categories?: string[];
}

const { tags = [], categories = [] } = Astro.props;

let names: { tags: Map<string, string>; categories: Map<string, string> };

async function termNames() {
  if (!names) {
    const posts = await getCollection(
      'posts',
      ({ data }) => data.draft !== true,
    );

    names = {
      tags: new Map(
        collectTerms(posts, 'tags').map((term) => [term.slug, term.name]),
      ),
      categories: new Map(
        collectTerms(posts, 'categories').map((term) => [term.slug, term.name]),
      ),
    };
  }

  return names;
}

function withoutRepeats(values: string[]): string[] {
  const seen = new Set<string>();

  return values.filter((value) => {
    const slug = termSlug(value);

    if (seen.has(slug)) return false;

    seen.add(slug);

    return true;
  });
}

const { tags: tagNames, categories: categoryNames } = await termNames();

const categoryList = withoutRepeats(categories);
const categorySlugs = new Set(categoryList.map(termSlug));

const tagList = withoutRepeats(tags).filter(
  (tag) => !categorySlugs.has(termSlug(tag)),
);

const nameOf = (value: string, kind: 'tags' | 'categories') =>
  (kind === 'tags' ? tagNames : categoryNames).get(termSlug(value)) ?? value;
---

{(categoryList.length > 0 || tagList.length > 0) && (
  <ul class="taxonomy-links">
    {categoryList.length > 0 && (
      <li class="taxonomy-group">
        <span class="taxonomy-label">Categories</span>
        <ul class="taxonomy-values">
          {categoryList.map((category) => (
            <li>
              <a href={withBase(`/categories/${termSlug(category)}/`)}>
                {nameOf(category, 'categories')}
              </a>
            </li>
          ))}
        </ul>
      </li>
    )}
    {tagList.length > 0 && (
      <li class="taxonomy-group">
        <span class="taxonomy-label">Tags</span>
        <ul class="taxonomy-values">
          {tagList.map((tag) => (
            <li>
              <a href={withBase(`/tags/${termSlug(tag)}/`)}>
                {nameOf(tag, 'tags')}
              </a>
            </li>
          ))}
        </ul>
      </li>
    )}
  </ul>
)}
