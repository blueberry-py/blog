---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import RelatedContent from '../components/RelatedContent.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TaxonomyLinks from '../components/TaxonomyLinks.astro';
import { relatedPosts } from '../lib/related.ts';
import { formatDate, formatDateTime, SITE_LICENSE } from '../lib/site.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;

const published = formatDateTime(post.data.date);
const cover = post.data.image
  ? new URL(post.data.image.src, Astro.site).href
  : undefined;

const related = relatedPosts(
  post,
  await getCollection('posts', ({ data }) => data.draft !== true),
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/post/${post.id}/`}
  type="article"
  section="Post"
  tags={post.data.tags}
  publishedTime={published}
  modifiedTime={published}
  image={cover}
  wide
>
  <div class="post-layout">
    <article class="post">
      <header class="post-header">
        {post.data.image && (
          <Image
            class="post-cover"
            src={post.data.image}
            alt={`Featured image of post ${post.data.title}`}
            width={800}
            layout="constrained"
          />
        )}
        <h1 class="post-title">{post.data.title}</h1>
        {post.data.description && (
          <p class="post-description">{post.data.description}</p>
        )}
        <p class="post-meta">
          <time datetime={formatDateTime(post.data.date)}>
            {formatDate(post.data.date)}
          </time>
        </p>
      </header>

      <TableOfContents headings={headings} variant="disclosure" />

      <div class="post-content">
        <slot />
      </div>

      <TaxonomyLinks tags={post.data.tags} categories={post.data.categories} />

      <footer class="post-footer">
        <p class="post-license">{SITE_LICENSE}</p>
      </footer>
    </article>

    <TableOfContents headings={headings} variant="rail" />

    <RelatedContent posts={related} />
  </div>
</BaseLayout>
