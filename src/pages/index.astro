---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import TaxonomyWidget from '../components/TaxonomyWidget.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_SUBTITLE, SITE_TITLE, withBase } from '../lib/site.ts';
import { sortPosts } from '../lib/posts.ts';
import { collectTerms, sortTerms } from '../lib/taxonomy.ts';

const posts = sortPosts(
  await getCollection('posts', ({ data }) => data.draft !== true),
);

const categories = sortTerms(collectTerms(posts, 'categories'));
const tags = sortTerms(collectTerms(posts, 'tags'));
---

<BaseLayout title={SITE_TITLE} description={SITE_SUBTITLE} path="/">
  <h1 class="page-title">{SITE_TITLE}</h1>
  <p class="page-subtitle">{SITE_SUBTITLE}</p>

  <div class="post-list">
    {posts.map((post) => (
      <PostCard post={post} href={withBase(`/post/${post.id}/`)} />
    ))}
  </div>

  <div class="widgets">
    <TaxonomyWidget
      title="Categories"
      indexHref="/categories/"
      terms={categories}
    />
    <TaxonomyWidget title="Tags" indexHref="/tags/" terms={tags} />
  </div>
</BaseLayout>
