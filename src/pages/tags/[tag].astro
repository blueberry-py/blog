---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Term } from '../../lib/taxonomy.ts';
import { collectTerms } from '../../lib/taxonomy.ts';
import { withBase } from '../../lib/site.ts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);

  return collectTerms(posts, 'tags').map((term) => ({
    params: { tag: term.slug },
    props: { term },
  }));
}

interface Props {
  term: Term;
}

const { term } = Astro.props;
---

<BaseLayout
  title={term.name}
  description={`The posts of BlueberryPy tagged ${term.name}`}
  path={`/tags/${term.slug}/`}
  feed={`/tags/${term.slug}/index.xml`}
>
  <h1 class="section-term">{term.name}</h1>

  <div class="post-list">
    {term.posts.map((post) => (
      <PostCard post={post} href={withBase(`/post/${post.id}/`)} />
    ))}
  </div>
</BaseLayout>
