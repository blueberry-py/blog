{
  "name": "blueberry-py-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && pnpm lint && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && markdownlint-cli2 \"**/*.md\"",
    "test": "node --test --test-concurrency=1 scripts/tooling.test.mjs scripts/migration/*.test.mjs scripts/routes.test.mjs scripts/taxonomy.test.mjs scripts/deployment.test.mjs scripts/repository.test.mjs",
    "test:migration": "node --test scripts/migration/*.test.mjs",
    "verify:content": "node scripts/migration/verify-content.mjs",
    "convert:frontmatter": "node scripts/migration/convert-frontmatter.mjs",
    "deploy:cloudflare": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.0",
    "@eslint/js": "10.0.1",
    "astro": "7.4.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4"
  }
}
