{
  "name": "blueberry-py-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:root": "node scripts/build-host.mjs root",
    "build:pages": "node scripts/build-host.mjs pages",
    "preview": "astro preview",
    "prepare": "husky",
    "check": "astro check && pnpm lint && pnpm format:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint . && markdownlint-cli2 \"**/*.md\"",
    "test": "node --test --test-concurrency=1 scripts/tooling.test.mjs scripts/collections.test.mjs scripts/legacy-redirects.test.mjs scripts/routes.test.mjs scripts/taxonomy.test.mjs scripts/deployment.test.mjs scripts/repository.test.mjs scripts/public-guard.test.mjs scripts/build-host.test.mjs scripts/cover.test.mjs",
    "deploy:cloudflare": "pnpm build:root && wrangler deploy",
    "deploy:netlify": "pnpm build:root && netlify deploy --dir dist"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@astrojs/markdown-remark": "^7.3.6",
    "@eslint/js": "10.0.1",
    "astro": "^7.4.8",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "^17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.78.0",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "~8.72.2",
    "wrangler": "^4.159.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.18.0"
}
