{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "endOfLine": "lf",
  "printWidth": 80,
  "astro": true,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".astro/",
    "public/",
    ".wrangler/",
    ".netlify/",
    ".superpowers/",
    "pnpm-lock.yaml",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.png",
    "**/*.gif",
    "**/*.webp",
    "**/*.avif",
    "**/*.ico",
    "**/*.pdf",
    "**/*.zip"
  ]
}
